# Copy this file to .env and fill in your own values.
# .env is in .gitignore. Never commit it and never paste keys into code.
#
# Quick start:  uv run python scripts/generate_secrets.py
# That copies this file to .env (if .env does not exist yet) and replaces every
# "change-me" below with a random value. It never prints the values.

# ---- Models (F4) ----
# Which provider get_chat_model() uses when none is passed: gemini, openai or mistral
MODEL_PROVIDER=gemini
GEMINI_MODEL=gemini-3.8-flash
OPENAI_MODEL=gpt-5-mini
MISTRAL_MODEL=mistral-small-2603
GOOGLE_API_KEY=your-gemini-key-here
OPENAI_API_KEY=your-openai-key-here
MISTRAL_API_KEY=your-mistral-key-here
# When a Gemini call fails (rate limit, timeout, server error), retry it on Mistral.
# Evaluation runs switch this off by themselves. See README > Models.
MODEL_FALLBACK=on

# ---- Langfuse server secrets (read by docker-compose.yml) ----
LANGFUSE_IMAGE_TAG=4
POSTGRES_PASSWORD=change-me
CLICKHOUSE_PASSWORD=change-me
REDIS_AUTH=change-me
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=change-me
SALT=change-me
# Must be 64 hex characters (32 bytes)
ENCRYPTION_KEY=change-me
NEXTAUTH_SECRET=change-me

# ---- Langfuse client (read by core/tracing.py) ----
# Create these keys in the Langfuse UI: your project > Settings > API Keys
LANGFUSE_BASE_URL=http://localhost:3000
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
